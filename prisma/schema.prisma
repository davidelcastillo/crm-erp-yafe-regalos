generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?            @default("-")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  code              String             @unique
  codePrefix        String?
  price             Decimal            @default(0) @db.Decimal(10, 2)
  categoryId        Int?
  category          Category?          @relation(fields: [categoryId], references: [id])
  active            Boolean            @default(true)
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  inventory         BranchInventory[]
  movements         BranchMovement[]   @relation("ProductMovements")
  stockControlItems StockControlItem[] @relation("ProductStockControlItems")
}

model Branch {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  phone      String?
  email      String?
  code       String   @unique
  authUserId String?  @unique
  isActive   Boolean  @default(true)
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventory     BranchInventory[]
  purchases     Purchase[]        @relation("BranchPurchases")
  sales         Sale[]            @relation("BranchSales")
  movements     BranchMovement[]  @relation("BranchMovements")
  cashMovements CashMovement[]    @relation("BranchCashMovements")
  cashCloses    CashClose[]       @relation("BranchCashCloses")
  stockControls StockControl[]    @relation("BranchStockControls")

  @@index([isActive])
  @@index([authUserId])
  @@index([code])
}

model BranchInventory {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock       Int      @default(0)
  lastUpdated DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model Purchase {
  id          Int            @id @default(autoincrement())
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())
  totalAmount Decimal        @default(0) @db.Decimal(10, 2)
  updatedAt   DateTime       @updatedAt
  branchId    Int
  branch      Branch         @relation("BranchPurchases", fields: [branchId], references: [id])
  items       PurchaseItem[]

  @@index([branchId])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  subtotal   Decimal  @db.Decimal(10, 2)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id             Int           @id @default(autoincrement())
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  totalAmount    Decimal       @default(0) @db.Decimal(10, 2)
  updatedAt      DateTime      @updatedAt
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  pendingBalance Decimal       @default(0) @db.Decimal(10, 2)
  customerId     Int?
  paymentMethod  PaymentMethod @default(EFECTIVO)
  branchId       Int
  branch         Branch        @relation("BranchSales", fields: [branchId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          SaleItem[]

  @@index([customerId])
  @@index([branchId])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  surname      String
  totalBalance Decimal   @default(0) @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
  sales        Sale[]
}

model Payment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  MIXTO
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model BranchMovement {
  id           Int          @id @default(autoincrement())
  productId    Int
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade, name: "ProductMovements")
  branchId     Int
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade, name: "BranchMovements")
  movementType MovementType // ENUM: ENTRY, EXIT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT
  quantity     Int
  reference    String? // e.g., purchase id, sale id, etc.
  createdAt    DateTime     @default(now())
  performedBy  String // user id or name
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// Plata que entra o sale de la caja de una sucursal fuera de una venta
// (correcciones de dinero). Reusa PaymentMethod para el medio.
model CashMovement {
  id          Int              @id @default(autoincrement())
  branchId    Int
  branch      Branch           @relation("BranchCashMovements", fields: [branchId], references: [id], onDelete: Cascade)
  type        CashMovementType
  method      PaymentMethod    @default(EFECTIVO)
  amount      Decimal          @db.Decimal(10, 2)
  // Fecha propia del movimiento (elegible), distinta de la de carga.
  date        DateTime         @default(now())
  description String?
  performedBy String
  createdAt   DateTime         @default(now())

  @@index([branchId])
  @@index([date])
}

enum CashMovementType {
  INGRESO
  EGRESO
}

// Cierre de caja por sucursal: guarda el corte para que las ventas anteriores
// queden como caja cerrada y los indicadores se puedan resetear.
model CashClose {
  id            Int      @id @default(autoincrement())
  branchId      Int
  branch        Branch   @relation("BranchCashCloses", fields: [branchId], references: [id], onDelete: Cascade)
  closedAt      DateTime @default(now())
  closedBy      String
  cashTotal     Decimal  @default(0) @db.Decimal(10, 2)
  transferTotal Decimal  @default(0) @db.Decimal(10, 2)
  mixedTotal    Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @default(0) @db.Decimal(10, 2)

  @@index([branchId, closedAt])
}

// --- Control de stock -------------------------------------------------------
// Cierre de inventario de una sucursal: se cuenta cada producto y se compara con
// el stock del sistema. Mientras está DRAFT no toca nada (se puede guardar y
// retomar); al cerrarse, el stock queda con lo contado y cada diferencia deja un
// BranchMovement ADJUSTMENT con su actor (S2/S6 de odd/tasks/control-stock-sucursal.md).
// La diferencia NO se guarda: es `countedStock - systemStock` y no se duplica
// un dato que puede quedar desincronizado.
model StockControl {
  id        Int                @id @default(autoincrement())
  branchId  Int
  branch    Branch             @relation("BranchStockControls", fields: [branchId], references: [id], onDelete: Cascade)
  status    StockControlStatus @default(DRAFT)
  startedAt DateTime           @default(now())
  closedAt  DateTime?
  closedBy  String?
  /**
   * Motivo del ajuste, escrito al cerrar: va en el PDF del ajuste (S10).
   */
  reason    String?
  items     StockControlItem[]

  @@index([branchId, closedAt])
  @@index([branchId, status])
}

enum StockControlStatus {
  DRAFT
  CLOSED
}

model StockControlItem {
  id           Int                  @id @default(autoincrement())
  controlId    Int
  control      StockControl         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product              @relation("ProductStockControlItems", fields: [productId], references: [id], onDelete: Cascade)
  /**
   * Stock del sistema al momento de contar.
   */
  systemStock  Int
  /**
   * Lo que se contó a mano.
   */
  countedStock Int
  /**
   * Qué se hizo con la diferencia: `PENDING` la deja visible para seguir
   * buscando la mercadería (el stock no cambia) y `ACCEPTED` ajusta el stock a
   * lo contado y deja el movimiento ADJUSTMENT (S9). Por defecto pendiente:
   * ajustar es siempre una decisión explícita.
   */
  decision     StockControlDecision @default(PENDING)

  @@unique([controlId, productId])
  @@index([controlId])
}

enum StockControlDecision {
  PENDING
  ACCEPTED
}
