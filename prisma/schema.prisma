generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String?             @default("-")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  code              String              @unique
  codePrefix        String?
  price             Decimal             @default(0) @db.Decimal(10, 2)
  categoryId        Int?
  category          Category?           @relation(fields: [categoryId], references: [id])
  active            Boolean             @default(true)
  // Destacado en la portada de la tienda: uno solo a la vez y solo si está
  // publicado en Web (lo garantizan la acción y la home; la base no lo impone).
  destacado         Boolean             @default(false)
  // Aditivo: una prenda es un Product con ficha PrendaDetalle (variante C).
  kind              ProductKind         @default(PRODUCT)
  prenda            PrendaDetalle?
  // Estilos del producto normal (las prendas los tienen en su ficha).
  estilosProducto   ProductEstilo[]
  // Variantes libres (color, tamaño, sabor…). Sin filas = sin variantes.
  variantes         ProductVariante[]
  publicaciones     PrendaPublicacion[]
  images            ProductImage[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  pedidoItems       PedidoItem[]
  inventory         BranchInventory[]
  movements         BranchMovement[]    @relation("ProductMovements")
  stockControlItems StockControlItem[]  @relation("ProductStockControlItems")
}

model Branch {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  phone      String?
  email      String?
  code       String   @unique
  authUserId String?  @unique
  isActive   Boolean  @default(true)
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventory     BranchInventory[]
  purchases     Purchase[]        @relation("BranchPurchases")
  sales         Sale[]            @relation("BranchSales")
  movements     BranchMovement[]  @relation("BranchMovements")
  cashMovements CashMovement[]    @relation("BranchCashMovements")
  cashCloses    CashClose[]       @relation("BranchCashCloses")
  stockControls StockControl[]    @relation("BranchStockControls")
  pedidoItems   PedidoItem[]

  @@index([isActive])
  @@index([authUserId])
  @@index([code])
}

model BranchInventory {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock       Int      @default(0)
  lastUpdated DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model Purchase {
  id          Int            @id @default(autoincrement())
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())
  totalAmount Decimal        @default(0) @db.Decimal(10, 2)
  updatedAt   DateTime       @updatedAt
  // Opcional: la compra del alta de un producto creado SIN sucursal se
  // registra igual (es un gasto de mercadería, no de una sucursal puntual).
  branchId    Int?
  branch      Branch?        @relation("BranchPurchases", fields: [branchId], references: [id])
  items       PurchaseItem[]

  @@index([branchId])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  subtotal   Decimal  @db.Decimal(10, 2)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id             Int           @id @default(autoincrement())
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  totalAmount    Decimal       @default(0) @db.Decimal(10, 2)
  updatedAt      DateTime      @updatedAt
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  pendingBalance Decimal       @default(0) @db.Decimal(10, 2)
  customerId     Int?
  paymentMethod  PaymentMethod @default(EFECTIVO)
  branchId       Int
  branch         Branch        @relation("BranchSales", fields: [branchId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  pedido         Pedido?

  @@index([customerId])
  @@index([branchId])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  surname      String
  totalBalance Decimal   @default(0) @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  phone        String?
  payments     Payment[]
  sales        Sale[]
  pedidos      Pedido[]
}

model Payment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  MIXTO
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model BranchMovement {
  id           Int          @id @default(autoincrement())
  productId    Int
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade, name: "ProductMovements")
  branchId     Int
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade, name: "BranchMovements")
  movementType MovementType // ENUM: ENTRY, EXIT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT
  quantity     Int
  reference    String? // e.g., purchase id, sale id, etc.
  createdAt    DateTime     @default(now())
  performedBy  String // user id or name
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// Plata que entra o sale de la caja de una sucursal fuera de una venta
// (correcciones de dinero). Reusa PaymentMethod para el medio.
model CashMovement {
  id          Int              @id @default(autoincrement())
  branchId    Int
  branch      Branch           @relation("BranchCashMovements", fields: [branchId], references: [id], onDelete: Cascade)
  type        CashMovementType
  method      PaymentMethod    @default(EFECTIVO)
  amount      Decimal          @db.Decimal(10, 2)
  // Fecha propia del movimiento (elegible), distinta de la de carga.
  date        DateTime         @default(now())
  description String?
  performedBy String
  createdAt   DateTime         @default(now())

  @@index([branchId])
  @@index([date])
}

enum CashMovementType {
  INGRESO
  EGRESO
}

// Cierre de caja por sucursal: guarda el corte para que las ventas anteriores
// queden como caja cerrada y los indicadores se puedan resetear.
model CashClose {
  id            Int      @id @default(autoincrement())
  branchId      Int
  branch        Branch   @relation("BranchCashCloses", fields: [branchId], references: [id], onDelete: Cascade)
  closedAt      DateTime @default(now())
  closedBy      String
  cashTotal     Decimal  @default(0) @db.Decimal(10, 2)
  transferTotal Decimal  @default(0) @db.Decimal(10, 2)
  mixedTotal    Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @default(0) @db.Decimal(10, 2)

  @@index([branchId, closedAt])
}

// --- Control de stock -------------------------------------------------------
// Cierre de inventario de una sucursal: se cuenta cada producto y se compara con
// el stock del sistema. Mientras está DRAFT no toca nada (se puede guardar y
// retomar); al cerrarse, el stock queda con lo contado y cada diferencia deja un
// BranchMovement ADJUSTMENT con su actor (S2/S6 de odd/tasks/control-stock-sucursal.md).
// La diferencia NO se guarda: es `countedStock - systemStock` y no se duplica
// un dato que puede quedar desincronizado.
model StockControl {
  id        Int                @id @default(autoincrement())
  branchId  Int
  branch    Branch             @relation("BranchStockControls", fields: [branchId], references: [id], onDelete: Cascade)
  status    StockControlStatus @default(DRAFT)
  startedAt DateTime           @default(now())
  closedAt  DateTime?
  closedBy  String?
  /**
   * Motivo del ajuste, escrito al cerrar: va en el PDF del ajuste (S10).
   */
  reason    String?
  items     StockControlItem[]

  @@index([branchId, closedAt])
  @@index([branchId, status])
}

enum StockControlStatus {
  DRAFT
  CLOSED
}

model StockControlItem {
  id           Int                  @id @default(autoincrement())
  controlId    Int
  control      StockControl         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product              @relation("ProductStockControlItems", fields: [productId], references: [id], onDelete: Cascade)
  /**
   * Stock del sistema al momento de contar.
   */
  systemStock  Int
  /**
   * Lo que se contó a mano.
   */
  countedStock Int
  /**
   * Qué se hizo con la diferencia: `PENDING` la deja visible para seguir
   * buscando la mercadería (el stock no cambia) y `ACCEPTED` ajusta el stock a
   * lo contado y deja el movimiento ADJUSTMENT (S9). Por defecto pendiente:
   * ajustar es siempre una decisión explícita.
   */
  decision     StockControlDecision @default(PENDING)

  @@unique([controlId, productId])
  @@index([controlId])
}

enum StockControlDecision {
  PENDING
  ACCEPTED
}

// --- Prendas ----------------------------------------------------------------
// Variante C: una prenda es un Product (nombre, código, precio, fotos, stock,
// ventas) con una ficha 1:1 para lo propio de la ropa. El costo vive acá, no en
// Product, para que la vista pública del catálogo nunca lo lea.
enum ProductKind {
  PRODUCT
  PRENDA
}

model PrendaDetalle {
  productId           Int             @id
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  esUnica             Boolean // second hand/intervenido = 1 unidad; ropa nueva admite cantidades
  categoriaId         Int
  categoria           CategoriaPrenda @relation(fields: [categoriaId], references: [id])
  condicionId         Int
  condicion           CondicionPrenda @relation(fields: [condicionId], references: [id])
  detalleCondicion    String? // «Con detalles (aclarar)»: texto libre junto a la condición
  detalleIntervencion String?
  costo               Decimal         @db.Decimal(10, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  estilos             PrendaEstilo[]
  medidas             PrendaMedida[]
  talles              PrendaTalle[]

  @@index([categoriaId])
  @@index([condicionId])
}

// S1: filas «Talle + Cantidad»; una prenda única lleva una sola (talle, 1).
model PrendaTalle {
  productId Int
  talle     String
  cantidad  Int
  prenda    PrendaDetalle @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([productId, talle])
  @@index([productId])
}

// Taxonomías creables: se desactivan, nunca se borran (hay prendas que las usan).
model CategoriaPrenda {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  // Prefijo del código de las prendas de esta categoría (U8: RP/RPI/RPH).
  // Sin prefijo no se puede dar de alta una prenda: el generador no tendría base.
  codePrefix        String?  @unique
  esUnicaPorDefecto Boolean  @default(true) // solo precarga el formulario
  active            Boolean  @default(true)
  prendas           PrendaDetalle[]
}

model CondicionPrenda {
  id      Int             @id @default(autoincrement())
  name    String          @unique
  active  Boolean         @default(true)
  prendas PrendaDetalle[]
}

model EstiloPrenda {
  id      Int            @id @default(autoincrement())
  name    String         @unique
  active  Boolean        @default(true)
  prendas  PrendaEstilo[]
  productos ProductEstilo[]
}

model PrendaEstilo {
  productId Int
  estiloId  Int
  prenda    PrendaDetalle @relation(fields: [productId], references: [productId], onDelete: Cascade)
  estilo    EstiloPrenda  @relation(fields: [estiloId], references: [id])

  @@id([productId, estiloId])
  @@index([estiloId])
}

// Estilos de un producto normal (los de prenda viven en PrendaEstilo).
model ProductEstilo {
  productId Int
  estiloId  Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  estilo    EstiloPrenda @relation(fields: [estiloId], references: [id])

  @@id([productId, estiloId])
  @@index([estiloId])
}

model MedidaTipo {
  id      Int            @id @default(autoincrement())
  name    String         @unique
  active  Boolean        @default(true)
  prendas PrendaMedida[]
}

model PrendaMedida {
  productId    Int
  medidaTipoId Int
  valorCm      Decimal       @db.Decimal(5, 1)
  prenda       PrendaDetalle @relation(fields: [productId], references: [productId], onDelete: Cascade)
  medidaTipo   MedidaTipo    @relation(fields: [medidaTipoId], references: [id])

  @@id([productId, medidaTipoId])
  @@index([medidaTipoId])
}

// Registro simple de «publicada en»: el sistema no publica en ningún canal.
// `canal` es texto libre a propósito (no FK a CanalVenta, que es del pedido).
model PrendaPublicacion {
  productId Int
  canal     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, canal])
}

// --- Fotos del producto (ADR-08) --------------------------------------------
// Hasta 4 fotos por `Product` de cualquier kind, la posición 0 es la portada
// (el rango 0..3 lo valida la Server Action: Prisma no expresa el CHECK).
// `path` guarda solo el prefijo del hash; los dos archivos del bucket
// `product-images` se derivan de ahí (`<path>_lg.webp` y `<path>_sm.webp`).
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  path      String
  alt       String?
  bytes     Int

  @@unique([productId, position])
}

// --- Pedidos ----------------------------------------------------------------
// Un pedido sale de UNA sucursal y, al pasar a PAGADO, genera la Sale que entra
// a caja (un solo registro de la verdad de la plata). El número V-0001 se
// genera con lock en el servidor. La reserva NO descuenta stock: es derivada.
model Pedido {
  id          Int               @id @default(autoincrement())
  numero      String            @unique
  customerId  Int
  customer    Customer          @relation(fields: [customerId], references: [id])
  canalId     Int
  canal       CanalVenta        @relation(fields: [canalId], references: [id])
  estado      PedidoEstado      @default(RESERVADO)
  total       Decimal           @db.Decimal(10, 2)
  venceEl     DateTime?
  envioMetodo EnvioMetodo?
  envioEstado EnvioPreparacion?
  ciudad      String?
  notas       String?
  saleId      Int?              @unique
  sale        Sale?             @relation(fields: [saleId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  pagadoAt    DateTime?
  entregadoAt DateTime?
  canceladoAt DateTime?
  createdBy   String
  updatedBy   String
  items       PedidoItem[]
  pagos       PedidoPago[]

  @@index([estado, canalId])
  @@index([estado, venceEl])
  @@index([customerId])
}

model PedidoItem {
  id        Int     @id @default(autoincrement())
  pedidoId  Int
  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id])
  cantidad  Int
  precio    Decimal @db.Decimal(10, 2) // foto del precio al reservar
  subtotal  Decimal @db.Decimal(10, 2)

  @@index([pedidoId])
  @@index([productId, branchId])
}

model PedidoPago {
  id          Int           @id @default(autoincrement())
  pedidoId    Int
  pedido      Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  monto       Decimal       @db.Decimal(10, 2)
  metodo      PaymentMethod
  fecha       DateTime      @default(now())
  performedBy String

  @@index([pedidoId])
}

enum PedidoEstado {
  RESERVADO
  PAGADO
  PARA_ENVIAR
  ENTREGADO
  CANCELADO
}

model CanalVenta {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  active  Boolean  @default(true)
  pedidos Pedido[]
}

enum EnvioMetodo {
  CORREO
  ENCOMIENDA
  RETIRO
}

enum EnvioPreparacion {
  COORDINAR
  FALTA_EMBALAR
  ETIQUETA_LISTA
}

// Variantes de un producto normal: nombre libre + cantidad (suma el stock).
model ProductVariante {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nombre    String
  cantidad  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, nombre])
  @@index([productId])
}
