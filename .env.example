# ── Base de datos (Prisma) ──────────────────────────────────────────────────
# URL de conexión a la base de datos PostgreSQL de Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/db"
# URL directa (usada por Prisma en entornos de CI).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/db"
# Opcional: otra base local para los tests. Por defecto se usa la del stack de Supabase
# (`supabase db start`); un destino que no sea local se rechaza.
DATABASE_URL_TEST="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase (Auth + cliente) ───────────────────────────────────────────────
# URL pública del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
# Key publishable (anon) para el cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Key anon (legacy JWT) para el cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Key de servicio para operaciones de admin (seed, migraciones, provisioning de usuarios de sucursal).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Aplicación ──────────────────────────────────────────────────────────────
# development | staging | production (afecta comportamiento de middlewares y feature flags).
NEXT_PUBLIC_APP_ENV="development"

# ── Feature flags (Fase 2/3) ────────────────────────────────────────────────
# true si se quiere habilitar la gestión de sucursales.
NEXT_PUBLIC_FEATURE_BRANCHES=true
# true si se quiere habilitar categorías de productos.
NEXT_PUBLIC_FEATURE_CATEGORIES=true
# true si se quiere habilitar el soft-delete de productos.
NEXT_PUBLIC_FEATURE_SOFT_DELETE=true
# true si se quiere habilitar la vista externa de inventario por sucursal (portal de solo lectura).
NEXT_PUBLIC_FEATURE_EXTERNAL_BRANCH_VIEW=true

# ── Sucursales (Fase 4) ─────────────────────────────────────────────────────
# Dominio usado para generar el email del usuario de sucursal (sucursal-<code>@<domain>).
BRANCH_EMAIL_DOMAIN="feriaconexx.com"
# Email del usuario admin usado por scripts/backfill-admin-claim.mjs (si se omite, toma el primer usuario con email).
ADMIN_EMAIL=""
